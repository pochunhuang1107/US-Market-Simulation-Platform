# Minimal local development
# Copy this file to .env. These values match the app's local defaults and are
# safe to keep for development.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/market_simulator
ENV=local
AUTH_MODE=dev

# Optional dev admin override
# Keep disabled by default. Enable only for local entitlement/admin testing.
ENABLE_DEV_ADMIN_OVERRIDE=false
# DEV_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
# DEV_ADMIN_USER_IDS=00000000-0000-0000-0000-000000000001
# DEV_ADMIN_DAILY_FREE_RUNS=999999
# DEV_ADMIN_MAX_SAVED_STRATEGIES=999999
# DEV_ADMIN_MAX_TRACKED_STRATEGIES=999999
# DEV_ADMIN_BUILDER_PROMPT_DAILY_LIMIT=999999
# DEV_ADMIN_BUILDER_PROMPT_MAX_CHARS=20000
# DEV_ADMIN_MAX_BACKTEST_YEARS=25

# Curated data paths
# The app should read curated ETF and reference-series paths only. Replace the
# placeholder bucket with your own market-data bucket in local .env or deploy
# environment configuration.
# MARKET_DATA_PATH=s3://your-market-data-bucket/curated/etf_daily_prices/**/*.parquet
# ETF_METADATA_S3_URI=s3://your-market-data-bucket/curated/reference/etf_symbol_metadata/data.parquet
# REFERENCE_SERIES_DATA_PATH=s3://your-market-data-bucket/curated/reference_series
# REFERENCE_SERIES_METADATA_S3_URI=s3://your-market-data-bucket/curated/reference/reference_series_metadata/data.parquet
# DUCKDB_DATABASE=:memory:
# S3_REGION=us-west-2

# Artifact storage
# LOCAL is the default and is enough for development. Use S3 only in
# beta/production or when explicitly testing S3 artifact storage.
# ARTIFACT_STORAGE_BACKEND=LOCAL
# ARTIFACTS_DIR=./data/local_artifacts
# ARTIFACT_STORAGE_BACKEND=S3
# ARTIFACT_S3_BUCKET=your-artifact-bucket
# ARTIFACT_S3_PREFIX=artifacts
# ARTIFACT_S3_REGION=us-west-2
# ARTIFACT_PRESIGN_TTL_SECONDS=3600

# Optional supported data/symbol overrides
# Omit SUPPORTED_DATA_END_DATE to let the app default to today's date.
# SUPPORTED_DATA_START_DATE=2018-01-02
# SUPPORTED_DATA_END_DATE=YYYY-MM-DD
# SUPPORTED_ETF_SYMBOLS=SPY,QQQ,DIA,IWM,VTI,GLD,SLV,TLT,IEF,HYG,LQD,XLF,XLK,XLE,XLV,XLY,XLP,XLI,XLU,XLB,XLRE,ARKK,VUG,VTV,QUAL,MTUM,IBIT
# SUPPORTED_REFERENCE_SERIES_SYMBOLS=VIX,VIX9D,VXEEM,DGS10,DGS2,T10Y2Y,DFF

# Beta/production auth notes
# Use ENV=beta or ENV=production in protected environments. Do not use dev auth
# there, and do not rely on client-provided X-User-Id. Protected environments
# must use bearer JWT auth from an OIDC-compatible provider.
# AUTH_MODE=oidc
# OIDC_ISSUER=https://your-issuer.example.com/
# OIDC_AUDIENCE=your-api-audience
# OIDC_JWKS_URL=https://your-issuer.example.com/.well-known/jwks.json
# OIDC_EMAIL_CLAIM=email
# OIDC_SUBJECT_CLAIM=sub
# OIDC_DISPLAY_NAME_CLAIM=name
