# Beta backend environment template
# Placeholder values only. Do not copy real database passwords, Auth0 secrets,
# private S3 bucket names, or local machine paths into committed files.
#
# Local dev uses .env.example with ENV=local and AUTH_MODE=dev.
# docker-compose.beta-local.yml is self-contained for packaging smoke and does
# not load this file.

DATABASE_URL=postgresql+psycopg://db_user:db_password@db-host.example.com:5432/market_simulator
ENV=beta
AUTH_MODE=oidc

# Auth0/OIDC backend token validation
OIDC_PROVIDER_NAME=auth0
OIDC_JWKS_URL=https://your-tenant.region.auth0.com/.well-known/jwks.json
OIDC_ISSUER=https://your-tenant.region.auth0.com/
OIDC_AUDIENCE=your-api-audience
OIDC_EMAIL_CLAIM=email
OIDC_SUBJECT_CLAIM=sub
OIDC_DISPLAY_NAME_CLAIM=name
OIDC_ALLOW_EMAIL_LINKING=true

# Curated market/reference data
MARKET_DATA_PATH=s3://your-market-data-bucket/curated/etf_daily_prices/**/*.parquet
ETF_METADATA_S3_URI=s3://your-market-data-bucket/curated/reference/etf_symbol_metadata/data.parquet
REFERENCE_SERIES_DATA_PATH=s3://your-market-data-bucket/curated/reference_series
REFERENCE_SERIES_METADATA_S3_URI=s3://your-market-data-bucket/curated/reference/reference_series_metadata/data.parquet
MODEL_SIGNAL_DATA_PATH=
DUCKDB_DATABASE=:memory:
S3_REGION=us-west-2

# Beta artifacts should be durable and shared by API and worker.
ARTIFACT_STORAGE_BACKEND=S3
ARTIFACT_S3_BUCKET=your-artifact-bucket
ARTIFACT_S3_PREFIX=artifacts
ARTIFACT_S3_REGION=us-west-2
ARTIFACT_PRESIGN_TTL_SECONDS=3600

# Safety defaults
ENABLE_DEV_ADMIN_OVERRIDE=false
QUEUE_OLDEST_WARNING_SECONDS=600
RUNNING_STALE_SECONDS=300

# Optional supported data/symbol overrides
SUPPORTED_DATA_START_DATE=2018-01-02
# SUPPORTED_DATA_END_DATE=YYYY-MM-DD
# SUPPORTED_ETF_SYMBOLS=SPY,QQQ,DIA,IWM,VTI,GLD,SLV,TLT,IEF,HYG,LQD,XLF,XLK,XLE,XLV,XLY,XLP,XLI,XLU,XLB,XLRE,ARKK,VUG,VTV,QUAL,MTUM,IBIT
# SUPPORTED_REFERENCE_SERIES_SYMBOLS=VIX,VIX9D,VXEEM,DGS10,DGS2,T10Y2Y,DFF

# Strategy Builder translation provider
# Keep deterministic for beta by default. Use openai only for direct adapter
# testing. Use hybrid for product-like AI fallback: common prompts stay on the
# fast deterministic path, and OpenAI is used only when fallback is needed.
STRATEGY_BUILDER_PROVIDER=deterministic
# STRATEGY_BUILDER_LLM_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TIMEOUT_SECONDS=20
# OPENAI_MAX_RETRIES=1
# OPENAI_FALLBACK_DAILY_LIMIT_PER_USER=25
# OPENAI_FALLBACK_DAILY_LIMIT_BY_PLAN=FREE:0,BETA_TESTER:100,PRO:100,RESEARCH:100,DEV_ADMIN:unlimited
# OPENAI_FALLBACK_MAX_PROMPT_CHARS=4000
# Optional approximate cost visibility. Leave unset unless pricing is managed
# as config for the deployed model.
# OPENAI_COST_PER_1K_INPUT_TOKENS_USD=
# OPENAI_COST_PER_1K_OUTPUT_TOKENS_USD=
