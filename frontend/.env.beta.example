# Beta frontend environment template
# Placeholder values only. Vite exposes VITE_* values in the browser bundle, so
# never put server-side secrets here.
#
# Local dev can omit this file or use frontend/.env.example with
# VITE_AUTH_PROVIDER=dev. docker-compose.beta-local.yml builds the frontend in
# dev/manual-token mode for packaging smoke.

VITE_AUTH_PROVIDER=auth0
VITE_AUTH0_DOMAIN=your-tenant.region.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=your-api-audience
VITE_AUTH0_REDIRECT_URI=https://your-beta-frontend.example.com

# Defaults shown. Use localstorage/refresh tokens only when Auth0 tenant
# settings and the browser storage risk are intentionally accepted.
VITE_AUTH0_CACHE_LOCATION=memory
VITE_AUTH0_USE_REFRESH_TOKENS=false
