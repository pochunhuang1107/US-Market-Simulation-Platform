# Local development keeps the frontend in manual/dev-token mode.
VITE_AUTH_PROVIDER=dev

# Auth0 beta configuration. Do not commit real tenant values.
# VITE_AUTH_PROVIDER=auth0
# VITE_AUTH0_DOMAIN=your-tenant.region.auth0.com
# VITE_AUTH0_CLIENT_ID=your-spa-client-id
# VITE_AUTH0_AUDIENCE=your-api-audience
# VITE_AUTH0_REDIRECT_URI=http://localhost:5173
# VITE_AUTH0_CACHE_LOCATION=memory
# VITE_AUTH0_USE_REFRESH_TOKENS=false

# Local Auth0 QA with refresh-token rotation enabled in Auth0:
# VITE_AUTH0_CACHE_LOCATION=localstorage
# VITE_AUTH0_USE_REFRESH_TOKENS=true
